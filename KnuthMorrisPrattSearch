import java.util.Scanner;

public class KnuthMorrisPrattSearch {

    public void executeSearch(String pattern, String text) {
        int patternLen = pattern.length();
        int textLen = text.length();

        int[] prefixLookup = new int[patternLen];
        int patternIndex = 0;

        generatePrefixLookup(pattern, patternLen, prefixLookup);

        int textIndex = 0;
        while (textIndex < textLen) {
            if (pattern.charAt(patternIndex) == text.charAt(textIndex)) {
                patternIndex++;
                textIndex++;
            }

            if (patternIndex == patternLen) {
                System.out.println("Found pattern at index " + (textIndex - patternIndex));
                patternIndex = prefixLookup[patternIndex - 1];
            } else if (textIndex < textLen && pattern.charAt(patternIndex) != text.charAt(textIndex)) {
                if (patternIndex != 0) {
                    patternIndex = prefixLookup[patternIndex - 1];
                } else {
                    textIndex++;
                }
            }
        }
    }

    private void generatePrefixLookup(String pattern, int length, int[] prefixLookup) {
        int matchedPrefixLen = 0;
        int index = 1;
        prefixLookup[0] = 0;

        while (index < length) {
            if (pattern.charAt(index) == pattern.charAt(matchedPrefixLen)) {
                matchedPrefixLen++;
                prefixLookup[index] = matchedPrefixLen;
                index++;
            } else {
                if (matchedPrefixLen != 0) {
                    matchedPrefixLen = prefixLookup[matchedPrefixLen - 1];
                } else {
                    prefixLookup[index] = 0;
                    index++;
                }
            }
        }
    }

    public static void main(String[] args) {
        Scanner inputScanner = new Scanner(System.in);

        System.out.print("Enter the text to search in: ");
        String text = inputScanner.nextLine();

        System.out.print("Enter the pattern to search for: ");
        String pattern = inputScanner.nextLine();

        KnuthMorrisPrattSearch kmpSearcher = new KnuthMorrisPrattSearch();
        kmpSearcher.executeSearch(pattern, text);

        inputScanner.close();
    }
}
